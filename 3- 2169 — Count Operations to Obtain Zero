int countOperations(int num1, int num2) {
    int count = 0;

    // Continue until either num1 or num2 becomes 0
    while (num1 > 0 && num2 > 0) {
        if (num1 >= num2) {
            num1 = num1 - num2; // Subtract num2 from num1
        } else {
            num2 = num2 - num1; // Subtract num1 from num2
        }
        count++; // Increment operation counter
    }

    return count;
}
