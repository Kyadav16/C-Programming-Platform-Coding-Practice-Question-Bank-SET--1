#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // Inner loop controls column number (1 to n)
        for (int j = 1; j <= n; j++) {
            // Print the product of row 'i' and column 'j'
            printf("%d", i * j);

            // Print space between numbers, but no trailing space at the end of the line
            if (j < n) {
                printf(" ");
            }
        }
        // Move to the next line after completing each row
        printf("\n");
    }

    return 0;
}
