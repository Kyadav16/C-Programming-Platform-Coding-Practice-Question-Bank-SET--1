#include <stdbool.h>

bool isPalindrome(int x) {
    // Negative numbers are not palindromes (e.g., -121 becomes 121-)
    // Numbers ending in 0 (except 0 itself) are not palindromes (e.g., 10 becomes 01)
    if (x < 0 || (x % 10 == 0 && x != 0)) {
        return false;
    }

    long reversed = 0;
    int original = x;

    // Reverse the integer
    while (x > 0) {
        int digit = x % 10;
        reversed = reversed * 10 + digit;
        x /= 10;
    }

    // Check if original number equals reversed number
    return original == reversed;
}
