int numberOfSteps(int num) {
    int count = 0;

    // Repeat until the number becomes zero
    while (num > 0) {
        if (num % 2 == 0) {
            num = num / 2; // If even, divide by 2
        } else {
            num = num - 1; // If odd, subtract 1
        }
        count++; // Increment step counter
    }

    return count;
}
