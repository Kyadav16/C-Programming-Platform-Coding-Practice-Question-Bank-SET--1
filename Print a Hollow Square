#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row index (0 to n - 1)
    for (int row = 0; row < n; row++) {
        // Inner loop controls column index (0 to n - 1)
        for (int col = 0; col < n; col++) {
            // Print '*' if the cell is on any of the 4 outer boundaries
            if (row == 0 || row == n - 1 || col == 0 || col == n - 1) {
                printf("*");
            } else {
                printf(" ");
            }
        }
        // Move to the next line after completing each row
        printf("\n");
    }

    return 0;
}
