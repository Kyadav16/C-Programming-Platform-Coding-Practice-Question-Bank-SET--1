#include <stdbool.h>

bool isPowerOfTwo(int n) {
    // A power of two must be strictly greater than 0.
    // In binary, a power of two has exactly one '1' bit (e.g., 8 is 1000).
    // Subtracting 1 flips all bits after that '1' bit (e.g., 7 is 0111).
    // Bitwise AND of (n & (n - 1)) will be 0 if n is a power of two.
    return (n > 0) && ((n & (n - 1)) == 0);
}
