#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // Inner loop controls column position for row 'i'
        for (int j = 1; j <= i; j++) {
            // Print '*' if on the left boundary, diagonal boundary, or bottom row
            if (j == 1 || j == i || i == n) {
                printf("*");
            } else {
                printf(" ");
            }
        }
        // Move to the next line after completing each row
        printf("\n");
    }

    return 0;
}
