#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // Inner loop prints 'i' asterisks on row 'i'
        for (int j = 1; j <= i; j++) {
            printf("*");
        }
        // Move to the next line
        printf("\n");
    }

    return 0;
}
