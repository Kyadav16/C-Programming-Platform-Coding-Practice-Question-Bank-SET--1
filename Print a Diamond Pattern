#include <stdio.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    // --- Upper Half (including the middle widest row: rows 1 to n) ---
    for (int i = 1; i <= n; i++) {
        // Leading spaces for centering: n - i
        for (int j = 1; j <= n - i; j++) {
            printf(" ");
        }
        // Asterisks: 2 * i - 1
        for (int k = 1; k <= 2 * i - 1; k++) {
            printf("*");
        }
        printf("\n");
    }

    // --- Lower Half (n - 1 rows: rows n - 1 down to 1) ---
    for (int i = n - 1; i >= 1; i--) {
        // Leading spaces for centering: n - i
        for (int j = 1; j <= n - i; j++) {
            printf(" ");
        }
        // Asterisks: 2 * i - 1
        for (int k = 1; k <= 2 * i - 1; k++) {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
