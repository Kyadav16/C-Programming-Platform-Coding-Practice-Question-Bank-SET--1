#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // Inner loop prints numbers from 1 to i
        for (int j = 1; j <= i; j++) {
            printf("%d", j);
            
            // Print space between numbers, but no trailing space after the last number
            if (j < i) {
                printf(" ");
            }
        }
        // Move to the next line
        printf("\n");
    }

    return 0;
}
