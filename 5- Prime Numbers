#include <stdio.h>

int main() {
    int n;
    // Reading input from STDIN
    scanf("%d", &n);

    int is_prime = 1; // Assume the number is prime initially

    // Check for factors from 2 up to sqrt(n) (i.e., i * i <= n)
    for (int i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            is_prime = 0; // Found a factor, so n is not prime
            break;
        }
    }

    // Print 1 for prime, 0 for non-prime followed by \n
    printf("%d\n", is_prime);

    return 0;
}
