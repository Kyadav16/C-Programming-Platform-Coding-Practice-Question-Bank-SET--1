#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int count = 1; // Counter that continuously increments across all rows

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // Inner loop prints 'i' numbers on row 'i'
        for (int j = 1; j <= i; j++) {
            printf("%d", count);
            count++; // Increment counter after printing

            // Print space between numbers, but no trailing space after the last number
            if (j < i) {
                printf(" ");
            }
        }
        // Move to the next line after completing each row
        printf("\n");
    }

    return 0;
}
