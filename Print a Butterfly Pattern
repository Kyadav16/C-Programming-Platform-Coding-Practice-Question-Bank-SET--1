#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int half = n / 2; // Size of upper and lower wings

    // --- Upper Half (rows 1 to half + 1) ---
    for (int i = 1; i <= half + 1; i++) {
        // Left wing
        for (int j = 1; j <= i; j++) {
            printf("*");
        }
        // Central gap of spaces
        for (int j = 1; j <= 2 * (half + 1 - i); j++) {
            printf(" ");
        }
        // Right wing
        for (int j = 1; j <= i; j++) {
            printf("*");
        }
        printf("\n");
    }

    // --- Lower Half (rows half down to 1) ---
    for (int i = half; i >= 1; i--) {
        // Left wing
        for (int j = 1; j <= i; j++) {
            printf("*");
        }
        // Central gap of spaces
        for (int j = 1; j <= 2 * (half + 1 - i); j++) {
            printf(" ");
        }
        // Right wing
        for (int j = 1; j <= i; j++) {
            printf("*");
        }
        printf("\n");
    }

    return 0;
}
