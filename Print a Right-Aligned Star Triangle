#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // First inner loop prints (n - i) spaces for right alignment
        for (int j = 1; j <= n - i; j++) {
            printf(" ");
        }

        // Second inner loop prints 'i' asterisks
        for (int k = 1; k <= i; k++) {
            printf("*");
        }

        // Move to the next line
        printf("\n");
    }

    return 0;
}
