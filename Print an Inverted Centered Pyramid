#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    // Outer loop controls row number (1 to n)
    for (int i = 1; i <= n; i++) {
        // First inner loop prints (i - 1) leading spaces
        for (int j = 1; j <= i - 1; j++) {
            printf(" ");
        }

        // Second inner loop prints 2 * (n - i) + 1 asterisks
        for (int k = 1; k <= 2 * (n - i) + 1; k++) {
            printf("*");
        }

        // Move to the next line
        printf("\n");
    }

    return 0;
}
