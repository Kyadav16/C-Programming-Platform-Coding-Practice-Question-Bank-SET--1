#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    int n;
    scanf("%d", &n);
    
    // Total size of the square grid is 2*n - 1
    int size = 2 * n - 1;

    for (int row = 0; row < size; row++) {
        for (int col = 0; col < size; col++) {
            
            // Calculate minimum distance to any of the 4 edges
            int min_dist = row;
            if (col < min_dist) min_dist = col;
            if (size - 1 - row < min_dist) min_dist = size - 1 - row;
            if (size - 1 - col < min_dist) min_dist = size - 1 - col;
            
            // The value at (row, col) decreases as we get further from the boundary
            printf("%d ", n - min_dist);
        }
        printf("\n");
    }

    return 0;
}
