#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>

int main() 
{
    int a, b;
    scanf("%d\n%d", &a, &b);

    // Array of string representations for numbers 1 to 9
    char *words[] = {"one", "two", "three", "four", "five", "six", "seven", "eight", "nine"};

    // Loop through all numbers in the inclusive interval [a, b]
    for (int i = a; i <= b; i++) {
        if (i >= 1 && i <= 9) {
            // Print the corresponding lowercase word (i-1 gives the 0-based index)
            printf("%s\n", words[i - 1]);
        } else if (i % 2 == 0) {
            // Print "even" if i > 9 and i is even
            printf("even\n");
        } else {
            // Print "odd" if i > 9 and i is odd
            printf("odd\n");
        }
    }

    return 0;
}
